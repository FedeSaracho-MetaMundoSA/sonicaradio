rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /messages/{messageId} {
      allow read, write, delete: if true;
    }
    match /site_config/{configId} {
      allow read, write: if true;
    }
  }
}

